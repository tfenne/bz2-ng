Puts the prefetches of the recursion's partial-order (6k) and final
induction scans under LIBSAIS_RECURSION_PREFETCH, which defaults to 1.
Applies after 0003-repetitive-recursion.patch.

libsais_partial_sorting_scan_{left_to_right,right_to_left}_32s_6k and
libsais_final_sorting_scan_{left_to_right,right_to_left}_32s, the scans
of libsais_main_32s_recursion's levels, begin each step of their main
loop with prefetches of entries ahead in SA, of the symbols those
entries point to and of their buckets; the final scans also load a
symbol for each bucket prefetch. With the macro defined to 0 those
statements are left out and the loops are otherwise unchanged; the macro
changes no access the scans make to SA, T or the buckets, so the suffix
array is the same either way. With the macro undefined or 1 the compiled
code is libsais's.

lib/sort_libsais.c sets it to 0 on AArch64. On the M4 the recursion's
levels of a 900 kB block fit in its 16 MB L2, and the prefetches and the
loads that compute their addresses cost more than they save.

Measured with libsais 2.12.0 on the M4 Max with Apple clang 21, the sort
stage alone (bzng_sort_block on every level-9 block of the corpora, 5
rounds interleaved with an identical build as control), the series with
the macro 0 against the same series with it 1, 16 KiB / 64 KiB /
whole-file streams: XA:Z 1.04 / even / 1.03, quality strings even / 1.02
/ 1.01, Silesia 1.06 (XA:Z 16 KiB and whole, quality strings 64 KiB and
Silesia faster in at least 4 of 5 rounds); MC:Z, whose blocks take
0003's recursion, 0.99 / 1.05 / 0.99, which code placement alone moves
as far. The series measured also kept the LMS positions of the blocks
without the list as a bitmap.

--- a/libsais.c
+++ b/libsais.c
@@ -5,6 +5,7 @@
  *
  * 0001-keep-lms-positions.patch
  * 0003-repetitive-recursion.patch
+ * 0005-recursion-prefetch.patch
  */
 
 /*--
@@ -252,6 +253,15 @@
     #define libsais_prefetchw(address) __prefetch2((const void *)(address), 16)
 #else
     #error Your compiler, configuration or platform is not supported.
+#endif
+
+/*
+ * bz2-ng: the prefetches of the recursion's partial-order (6k) and final
+ * induction scans are compiled only where LIBSAIS_RECURSION_PREFETCH is
+ * nonzero, the default.
+ */
+#if !defined(LIBSAIS_RECURSION_PREFETCH)
+    #define LIBSAIS_RECURSION_PREFETCH 1
 #endif
 
 #if !defined(__LITTLE_ENDIAN__) && !defined(__BIG_ENDIAN__)
@@ -3733,6 +3743,7 @@
     fast_sint_t i, j;
     for (i = omp_block_start, j = omp_block_start + omp_block_size - 2 * prefetch_distance - 1; i < j; i += 2)
     {
+#if LIBSAIS_RECURSION_PREFETCH
         libsais_prefetchr(&SA[i + 3 * prefetch_distance]);
 
         const sa_sint_t * Ts0 = &T[SA[i + 2 * prefetch_distance + 0] & SAINT_MAX]; libsais_prefetchr(Ts0 - 1); libsais_prefetchr(Ts0 - 2);
@@ -3740,6 +3751,7 @@
 
         sa_sint_t p0 = SA[i + prefetch_distance + 0] & SAINT_MAX; libsais_prefetchw(&buckets[BUCKETS_INDEX4((fast_sint_t)T[(sa_uint_t)(p0 - (p0 > 0))], 0)]);
         sa_sint_t p1 = SA[i + prefetch_distance + 1] & SAINT_MAX; libsais_prefetchw(&buckets[BUCKETS_INDEX4((fast_sint_t)T[(sa_uint_t)(p1 - (p1 > 0))], 0)]);
+#endif
 
         sa_sint_t p2 = SA[i + 0]; d += (p2 < 0); p2 &= SAINT_MAX; sa_sint_t v2 = BUCKETS_INDEX4(T[p2 - 1], T[p2 - 2] >= T[p2 - 1]);
         sa_sint_t * bucket_v2 = &buckets[v2]; SA[bucket_v2[0]++] = (p2 - 1) | (sa_sint_t)((sa_uint_t)(bucket_v2[2] != d) << (SAINT_BIT - 1)); bucket_v2[2] = d;
@@ -4806,6 +4818,7 @@
     fast_sint_t i, j;
     for (i = omp_block_start + omp_block_size - 1, j = omp_block_start + 2 * prefetch_distance + 1; i >= j; i -= 2)
     {
+#if LIBSAIS_RECURSION_PREFETCH
         libsais_prefetchr(&SA[i - 3 * prefetch_distance]);
 
         const sa_sint_t * Ts0 = &T[SA[i - 2 * prefetch_distance - 0] & SAINT_MAX]; libsais_prefetchr(Ts0 - 1); libsais_prefetchr(Ts0 - 2);
@@ -4813,6 +4826,7 @@
 
         sa_sint_t p0 = SA[i - prefetch_distance - 0] & SAINT_MAX; libsais_prefetchw(&buckets[BUCKETS_INDEX4((fast_sint_t)T[(sa_uint_t)(p0 - (p0 > 0))], 0)]);
         sa_sint_t p1 = SA[i - prefetch_distance - 1] & SAINT_MAX; libsais_prefetchw(&buckets[BUCKETS_INDEX4((fast_sint_t)T[(sa_uint_t)(p1 - (p1 > 0))], 0)]);
+#endif
 
         sa_sint_t p2 = SA[i - 0]; d += (p2 < 0); p2 &= SAINT_MAX; sa_sint_t v2 = BUCKETS_INDEX4(T[p2 - 1], T[p2 - 2] > T[p2 - 1]);
         sa_sint_t * bucket_v2 = &buckets[v2]; SA[--bucket_v2[0]] = (p2 - 1) | (sa_sint_t)((sa_uint_t)(bucket_v2[2] != d) << (SAINT_BIT - 1)); bucket_v2[2] = d;
@@ -6826,12 +6840,14 @@
     fast_sint_t i, j;
     for (i = omp_block_start, j = omp_block_start + omp_block_size - 2 * prefetch_distance - 1; i < j; i += 2)
     {
+#if LIBSAIS_RECURSION_PREFETCH
         libsais_prefetchw(&SA[i + 3 * prefetch_distance]);
 
         sa_sint_t s0 = SA[i + 2 * prefetch_distance + 0]; const sa_sint_t * Ts0 = &T[(sa_uint_t)(s0 > 0 ? s0 : 1)]; libsais_prefetchr(Ts0 - 1);
         sa_sint_t s1 = SA[i + 2 * prefetch_distance + 1]; const sa_sint_t * Ts1 = &T[(sa_uint_t)(s1 > 0 ? s1 : 1)]; libsais_prefetchr(Ts1 - 1);
         sa_sint_t s2 = SA[i + 1 * prefetch_distance + 0]; const sa_sint_t * Ts2 = &T[(sa_uint_t)(s2 > 0 ? s2 : 2)]; libsais_prefetchw(&induction_bucket[Ts2[-1]]); libsais_prefetchr(Ts2 - 2);
         sa_sint_t s3 = SA[i + 1 * prefetch_distance + 1]; const sa_sint_t * Ts3 = &T[(sa_uint_t)(s3 > 0 ? s3 : 2)]; libsais_prefetchw(&induction_bucket[Ts3[-1]]); libsais_prefetchr(Ts3 - 2);
+#endif
 
         sa_sint_t p0 = SA[i + 0]; SA[i + 0] = p0 ^ SAINT_MIN; if (p0 > 0) { p0--; SA[induction_bucket[T[p0]]++] = p0 | (sa_sint_t)((sa_uint_t)(T[(sa_uint_t)(p0 - (p0 > 0))] < T[p0]) << (SAINT_BIT - 1)); }
         sa_sint_t p1 = SA[i + 1]; SA[i + 1] = p1 ^ SAINT_MIN; if (p1 > 0) { p1--; SA[induction_bucket[T[p1]]++] = p1 | (sa_sint_t)((sa_uint_t)(T[(sa_uint_t)(p1 - (p1 > 0))] < T[p1]) << (SAINT_BIT - 1)); }
@@ -7806,12 +7822,14 @@
     fast_sint_t i, j;
     for (i = omp_block_start + omp_block_size - 1, j = omp_block_start + 2 * prefetch_distance + 1; i >= j; i -= 2)
     {
+#if LIBSAIS_RECURSION_PREFETCH
         libsais_prefetchw(&SA[i - 3 * prefetch_distance]);
 
         sa_sint_t s0 = SA[i - 2 * prefetch_distance - 0]; const sa_sint_t * Ts0 = &T[(sa_uint_t)(s0 > 0 ? s0 : 1)]; libsais_prefetchr(Ts0 - 1);
         sa_sint_t s1 = SA[i - 2 * prefetch_distance - 1]; const sa_sint_t * Ts1 = &T[(sa_uint_t)(s1 > 0 ? s1 : 1)]; libsais_prefetchr(Ts1 - 1);
         sa_sint_t s2 = SA[i - 1 * prefetch_distance - 0]; const sa_sint_t * Ts2 = &T[(sa_uint_t)(s2 > 0 ? s2 : 2)]; libsais_prefetchw(&induction_bucket[Ts2[-1]]); libsais_prefetchr(Ts2 - 2);
         sa_sint_t s3 = SA[i - 1 * prefetch_distance - 1]; const sa_sint_t * Ts3 = &T[(sa_uint_t)(s3 > 0 ? s3 : 2)]; libsais_prefetchw(&induction_bucket[Ts3[-1]]); libsais_prefetchr(Ts3 - 2);
+#endif
 
         sa_sint_t p0 = SA[i - 0]; if (p0 > 0) { p0--; SA[--induction_bucket[T[p0]]] = p0 | (sa_sint_t)((sa_uint_t)(T[(sa_uint_t)(p0 - (p0 > 0))] > T[p0]) << (SAINT_BIT - 1)); } else { SA[i - 0] = p0 & SAINT_MAX; }
         sa_sint_t p1 = SA[i - 1]; if (p1 > 0) { p1--; SA[--induction_bucket[T[p1]]] = p1 | (sa_sint_t)((sa_uint_t)(T[(sa_uint_t)(p1 - (p1 > 0))] > T[p1]) << (SAINT_BIT - 1)); } else { SA[i - 1] = p1 & SAINT_MAX; }
